<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- High-Performance Low-Latency Audio Features -->
    <uses-feature
        android:name="android.hardware.audio.low_latency"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.audio.output"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.audio.pro"
        android:required="false" />

    <!-- Graphics and Display -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- Multi-touch Virtual Arcade Controller -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch.distinct"
        android:required="true" />

    <!-- Storage Permissions for Arcade ROMs and BIOSes -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArcadeEngine.Fullscreen"
        android:hasCode="false">

        <!-- NativeActivity directly hosting C++ arcade engine -->
        <activity
            android:name="android.app.NativeActivity"
            android:label="@string/app_name"
            android:theme="@style/Theme.ArcadeEngine.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:resizeableActivity="false"
            android:exported="true">

            <!-- Name of the native C++ library (.so) -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="arcade_engine" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.GAME" />
            </intent-filter>
        </activity>
    </application>

</manifest>
