<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- High-Performance Low-Latency Audio Features (optional so all devices install) -->
    <uses-feature
        android:name="android.hardware.audio.low_latency"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.audio.output"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.audio.pro"
        android:required="false" />

    <!-- Graphics and Display -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- Multi-touch Virtual Arcade Controller -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch.distinct"
        android:required="false" />

    <!-- Storage Permissions for Arcade ROMs and BIOSes -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArcadeEngine.Fullscreen"
        android:extractNativeLibs="true">

        <!-- Launcher Activity: ROM Browser & File Selector -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.GAME" />
            </intent-filter>
        </activity>

        <!-- NativeActivity: High-Performance C++ Arcade Engine -->
        <activity
            android:name=".ArcadeActivity"
            android:label="@string/app_name"
            android:theme="@style/Theme.ArcadeEngine.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:exported="true">

            <!-- Name of the native C++ library (.so) -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="arcade_engine" />
        </activity>
    </application>

</manifest>
